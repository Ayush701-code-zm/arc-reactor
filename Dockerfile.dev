# Dev Ubuntu host for Tiny AWS (cgroup/ns). Root is intentional for privileged Linux APIs.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH=/usr/local/go/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    clang \
    cmake \
    curl \
    git \
    iproute2 \
    libbpf-dev \
    linux-libc-dev \
    llvm \
    pkg-config \
    python3 \
    protobuf-compiler \
    protobuf-compiler-grpc \
    libprotobuf-dev \
    libgrpc++-dev \
    util-linux \
    && rm -rf /var/lib/apt/lists/*

ARG GO_VERSION=1.22.12
ARG GO_ARCH=amd64
RUN curl -fsSL --proto '=https' --proto-redir '=https' \
      "https://go.dev/dl/go${GO_VERSION}.linux-${GO_ARCH}.tar.gz" -o /tmp/go.tgz \
    && tar -C /usr/local -xzf /tmp/go.tgz \
    && rm /tmp/go.tgz \
    && go version

WORKDIR /src
# NOSONAR - privileged host for namespaces/cgroups; not a production image
USER root
CMD ["bash"]
